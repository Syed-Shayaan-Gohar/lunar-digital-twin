<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="lunalab">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="libgz-sim-imu-system.so"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene: black "space" background, minimal ambient so the directional light does the shading work -->
    <scene>
      <ambient>0.08 0.08 0.08 1</ambient>
      <background>0 0 0 1</background>
      <grid>false</grid>
    </scene>

    <!-- GUI: explicit background_color so the interactive viewport also renders black -->
    <gui fullscreen="0">

      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.08 0.08 0.08</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree"/>

    </gui>

    <!-- Lunar gravity -->
    <gravity>0 0 -1.62</gravity>

    <!-- Dawn/Dusk sun simulation — ~4° elevation, per SPICE-HL³ paper's low-sun-angle config -->
    <light name="sun_light" type="directional">
      <pose>0 0 0.4 0 0 0</pose>
      <diffuse>1.0 0.953 0.937 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.7054 0.7054 -0.0698</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Ground plane: 11m x 8m test bed, basaltic gravel approximation -->
    <model name="lunalab_terrain">
      <pose>0 0 -0.3828 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_heightmap.png</uri>
              <size>11 8 0.4</size>
              <pos>0 0 -0.2008</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_heightmap.png</uri>
              <size>11 8 0.4</size>
              <pos>0 0 -0.2008</pos>
              <texture>
                <diffuse>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_diffuse.png</diffuse>
                <normal>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_normal.png</normal>
                <size>2</size>
              </texture>
            </heightmap>
          </geometry>
          <material>
            <ambient>0.25 0.22 0.18 1</ambient>
            <diffuse>0.30 0.27 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rocks (positive obstacles) — 8 of the 15 split "Moon Rocks" meshes
         (CC-BY 4.0, Ivan Vakulko / @milos4 on Sketchfab), chosen for size variety.
         IMPORTANT: source asset is authored Y-up; visual meshes get a fixed
         90° roll (1.5708 rad) to convert to Gazebo's Z-up convention. Collision
         stays a simple sphere (robust ODE physics, no convex decomposition needed).
         Sphere and mesh each have their own local <pose> within the link so both
         sit flush with local ground (z=0) independently of the model's pose,
         which just carries the rock's (x, y) placement on the terrain. -->
    <model name="rock_1">
      <static>true</static>
      <pose>2.5 1.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>1.0486 -0.5510 0.3261 0 0 0</pose>
          <geometry><sphere><radius>0.4804</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.2956 1.5708 0 0.4</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.013.obj</uri>
              <scale>0.2615 0.2615 0.2615</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>-1.8 -2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>-0.5604 -1.5838 0.1716 0 0 0</pose>
          <geometry><sphere><radius>0.3189</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.1527 1.5708 0 1.2</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.011.obj</uri>
              <scale>0.2903 0.2903 0.2903</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_3">
      <static>true</static>
      <pose>3.0 -1.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0.0419 -1.7434 0.2458 0 0 0</pose>
          <geometry><sphere><radius>0.4547</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.1877 1.5708 0 2.1</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.006.obj</uri>
              <scale>0.2603 0.2603 0.2603</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_4">
      <static>true</static>
      <pose>-3.2 2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>-0.8166 0.1518 0.1290 0 0 0</pose>
          <geometry><sphere><radius>0.3214</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.1230 1.5708 0 3.0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.008.obj</uri>
              <scale>0.2914 0.2914 0.2914</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_5">
      <static>true</static>
      <pose>4.0 3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>-1.1353 0.0677 0.1917 0 0 0</pose>
          <geometry><sphere><radius>0.2614</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.1661 1.5708 0 0.8</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.005.obj</uri>
              <scale>0.2607 0.2607 0.2607</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_6">
      <static>true</static>
      <pose>-4.5 -3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0.0027 1.5276 0.2571 0 0 0</pose>
          <geometry><sphere><radius>0.5118</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.2746 1.5708 0 4.2</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.016.obj</uri>
              <scale>0.2238 0.2238 0.2238</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_7">
      <static>true</static>
      <pose>0.0 3.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>1.2848 -1.2749 0.1864 0 0 0</pose>
          <geometry><sphere><radius>0.3026</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.1877 1.5708 0 5.0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.002.obj</uri>
              <scale>0.2636 0.2636 0.2636</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_8">
      <static>true</static>
      <pose>-0.5 0.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0.0142 0.0351 0.0913 0 0 0</pose>
          <geometry><sphere><radius>0.1765</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.0940 1.5708 0 1.7</pose>
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/rocks_split/rock.009.obj</uri>
              <scale>0.3081 0.3081 0.3081</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Craters (negative obstacles) — represented directly in the heightmap terrain above -->

  </world>
</sdf>