<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="lunalab">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene: black "space" background, minimal ambient so the directional light does the shading work -->
    <scene>
      <ambient>0.08 0.08 0.08 1</ambient>
      <background>0 0 0 1</background>
      <grid>false</grid>
    </scene>

    <!-- GUI: explicit background_color so the interactive viewport also renders black -->
    <gui fullscreen="0">

      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.08 0.08 0.08</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree"/>

    </gui>

    <!-- Lunar gravity -->
    <gravity>0 0 -1.62</gravity>

    <!-- TEMPORARY placeholder light — replaced with calibrated spotlight in Step 2 -->
    <light name="sun_light" type="directional">
      <pose>0 0 0.4 0 0 0</pose>
      <diffuse>1.0 0.953 0.937 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.7054 0.7054 -0.0698</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Ground plane: 11m x 8m test bed, basaltic gravel approximation -->
    <model name="lunalab_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_heightmap.png</uri>
              <size>11 8 0.4</size>
              <pos>0 0 -0.2008</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_heightmap.png</uri>
              <size>11 8 0.4</size>
              <pos>0 0 -0.2008</pos>
              <texture>
                <diffuse>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_diffuse.png</diffuse>
                <normal>file:///home/shayaan/lunar-digital-twin/worlds/lunalab_normal.png</normal>
                <size>2</size>
              </texture>
            </heightmap>
          </geometry>
          <material>
            <ambient>0.25 0.22 0.18 1</ambient>
            <diffuse>0.30 0.27 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rocks (positive obstacles) — 8 rocks, now using the real "Moon Rocks" mesh
         (CC-BY 4.0, Ivan Vakulko / @milos4 on Sketchfab) for visuals, with the
         original simple sphere kept as a collision proxy for robust physics
         (raw mesh collision can be unreliable in ODE without convex decomposition).
         Each instance varies in scale and rotation so they don't look like obvious
         copy-paste clones despite sharing one mesh. Tune <scale> per rock if the
         mesh's native size makes some look too big/small once you see it rendered. -->
    <model name="rock_1">
      <static>true</static>
      <pose>2.5 1.5 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.3 0.3 0.3</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>-1.8 -2.0 0.2 0.1 0 1.2</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.24 0.24 0.24</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_3">
      <static>true</static>
      <pose>3.0 -1.5 0.3 0 0.15 2.1</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.36 0.36 0.36</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_4">
      <static>true</static>
      <pose>-3.2 2.2 0.22 0.05 0 3.0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.26 0.26 0.26</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_5">
      <static>true</static>
      <pose>4.0 3.0 0.15 0 0 0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.18 0.18 0.18</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_6">
      <static>true</static>
      <pose>-4.5 -3.0 0.35 0.1 0.1 4.2</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.42 0.42 0.42</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_7">
      <static>true</static>
      <pose>0.0 3.5 0.18 0 0 5.0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.22 0.22 0.22</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rock_8">
      <static>true</static>
      <pose>-0.5 0.5 0.12 0 0.2 1.7</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/shayaan/lunar-digital-twin/meshes/moonrock.obj</uri>
              <scale>0.14 0.14 0.14</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Craters (negative obstacles) — represented directly in the heightmap terrain above -->

  </world>
</sdf>